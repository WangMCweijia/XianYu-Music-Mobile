<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 系统闪屏图标 · 浅色（夜间见 drawable-night-v31 同名文件）。
     HyperOS 3.0.305.0 实测仍会给 adaptive icon 合成方形容器并描 1px 暗毛边，
     白底上无法消除；浅色改用非自适应 layer-list（白底 + 居中 splash_logo，
     与 12 以下启动图同构）：非自适应 drawable 系统按原样绘制、不套容器。
     尺寸对齐夜间 adaptive 观感：带背景层的 adaptive icon 在闪屏按 240dp
     渲染，logo 高约 70dp。新版 logo 为竖构图（615×940，宽高比 0.654），
     splash_logo 画布按内容比例紧贴（80×123dp 基准，无留白），故 item
     定宽高 46x70dp 等比 + bitmap fill 拉伸，不会被压扁；此前 73x70dp
     是按旧方正 logo（592×571）算的，换图后会把竖构图压成方块。
     splash_logo 本体仍为 123dp 基准，供 12 以下窗口启动图沿用（居中绘制）。
     EMUI 安卓 16 忽略非自适应 icon 时回落默认启动器图标，观感等同。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item
        android:width="46dp"
        android:height="70dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
